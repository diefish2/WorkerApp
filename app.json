{
  "expo": {
    "name": "WorkerApp",
    "slug": "workerapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "workerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diefish2.workerapp"
    },
    "android": {
      "package": "com.diefish2.workerapp"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "WorkerApp 需要存取相片，讓你上載維修問題的圖片。"
        }
      ]
    ]
  }
}
